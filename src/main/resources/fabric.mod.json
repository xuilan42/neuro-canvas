{
  "schemaVersion": 1,
  "id": "neurocanvas",
  "version": "${version}",
  "name": "Neuro Canvas",
  "description": "Client-side visual mod: a menu of effects (target ring, particles, fog, sky, crosshair, HUD and more) and an AI chat that configures them for you.",
  "authors": [
    "xuilan42"
  ],
  "license": "GPL-3.0-only",
  "icon": "assets/neurocanvas/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.neurocanvas.client.NeuroCanvasClient"
    ]
  },
  "accessWidener": "neurocanvas.accesswidener",
  "mixins": [
    "neurocanvas.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~1.20.1",
    "java": ">=17"
  }
}
